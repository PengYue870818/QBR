    scaling_pass = bool(
        fit_delta["R2"] >= cfg.fit_R2_accept and fit_eps2["R2"] >= cfg.fit_R2_accept and fit_K["R2"] >= cfg.fit_R2_accept and
        fit_delta["rel_slope_error"] <= cfg.fit_slope_rel_accept and fit_eps2["rel_slope_error"] <= cfg.fit_slope_rel_accept and fit_K["rel_slope_error"] <= cfg.fit_slope_rel_accept
    )
    admissibility_pass = all(c[1] for c in checks)
    structure_pass = bool(scaling_pass and chi_series["chi_series_pass"] and env_scan["env_factorization_pass"])
    core_validation_pass = bool(admissibility_pass and structure_pass)
    top_journal_numerical_pass = bool(core_validation_pass and ((not cfg.direct_verify) or (direct_strict_pass and convergence["convergence_pass"])))

    regime = classify_regime(cfg, structure_pass, rem_ratio_time, Jres["Tchi_band_rel_err"], direct_strict_pass, convergence["convergence_pass"])

    direct_K_independent = direct_res.get("K_independent", np.nan) if direct_res is not None else np.nan
    direct_Tchi_phys_independent = direct_res.get("Tchi_phys_independent", np.nan) if direct_res is not None else np.nan

    direct_K_rel_err = (
        abs(direct_K_independent - geom["K"]) / max(abs(geom["K"]), 1e-300)
        if np.isfinite(direct_K_independent)
        else np.nan
    )

    direct_Tchi_rel_err = (
        abs(direct_Tchi_phys_independent - Jres["Tchi_phys"]) / max(abs(Jres["Tchi_phys"]), 1e-300)
        if np.isfinite(direct_Tchi_phys_independent)
        else np.nan
    )

    summary = {
