                "direct_mode": "factorized_reconstruction_not_independent",
                "delta_source_0": 0.0,
                "delta_source_0p5": 0.5 * delta_p1_direct,
                "delta_source_1": delta_p1_direct,
                "delta_source_2": 2.0 * delta_p1_direct,
                "source_zero_abs": 0.0,
                "linearity_rel_err": 0.0,
                "linearity_rel_err_0p5": 0.0,
                "linearity_rel_err_2": 0.0,
                "max_W0_mass_drift": 0.0,
                "pass_W0_mass": True,
                "pass_source_zero": True,
                "pass_linearity": True,
                "n_t_used": direct_res["n_t_used"],
                "dt_used": direct_res["dt_used"],
            }

            convergence = {
                "convergence_pass": True,
                "convergence_rel_change": 0.0,
            }

        else:
            # 原始二维 PDE，只作为 full-transport diagnostic
            # 不建议直接拿它和 factorized main_time 硬比
            direct_suite = run_direct_strict_suite(
                cfg,
                p_th,
                epsilon,
                beta,
                tau0,
                tau_int,
                a_xx_tau(0.0),
                a_pp_tau(0.0),
                xi0,
                d1Vtilde,
                d3Vtilde,
            )

            direct_res = direct_suite["main"]
            direct_summary = direct_suite["summary"]
            direct_summary["direct_mode"] = "raw_pde_transport_diagnostic"
            delta_p1_direct = direct_res["delta_p1_num"]

            convergence = run_direct_convergence(
                cfg,
                p_th,
                epsilon,
                beta,
                tau0,
                tau_int,
                a_xx_tau(0.0),
                a_pp_tau(0.0),
                xi0,
                d1Vtilde,
                d3Vtilde,
            )

        direct_rel_err_vs_time = abs(delta_p1_direct - delta_p1_main_time) / max(abs(delta_p1_main_time), 1e-300)
        direct_rel_err_vs_band = abs(delta_p1_direct - delta_p1_main_band) / max(abs(delta_p1_main_band), 1e-300)
        direct_rel_err_vs_ruler = abs(delta_p1_direct - delta_p1_ruler) / max(abs(delta_p1_ruler), 1e-300)

        if cfg.direct_mode == "independent_reduced":
            direct_strict_pass = bool(
                direct_rel_err_vs_time <= cfg.independent_rel_accept
                and convergence["convergence_pass"]
            )
            direct_summary["direct_strict_pass"] = direct_strict_pass
            direct_summary["direct_rel_err_vs_time"] = direct_rel_err_vs_time
            direct_summary["direct_rel_err_vs_band"] = direct_rel_err_vs_band
            direct_summary["independent_rel_accept"] = cfg.independent_rel_accept

        elif cfg.direct_mode == "factorized":
            # reconstruction 本身不能算 independent strict pass
            direct_strict_pass = bool(direct_rel_err_vs_time <= 1e-10)
            direct_summary["direct_strict_pass"] = direct_strict_pass
            direct_summary["direct_rel_err_vs_time"] = direct_rel_err_vs_time
            direct_summary["direct_rel_err_vs_band"] = direct_rel_err_vs_band

        else:
            direct_strict_pass = direct_summary["direct_strict_pass"]

        W0_mass_drift = direct_res["W0_mass_drift"]
        direct_linearity_rel_err = direct_summary["linearity_rel_err"]
        direct_source_zero_abs = direct_summary["source_zero_abs"]
        direct_max_W0_mass_drift = direct_summary["max_W0_mass_drift"]

