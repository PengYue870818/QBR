def plot_spectral(cfg, omega_min, omega_max, Jres):
    if Jres["omega_grid"] is None:
        return
    om = Jres["omega_grid"]
    ch = Jres["chi_hat_vals_pos"]
    F = filter_rectangular_double_sided(om, cfg.delta_t)
    mask = (om >= omega_min) & (om <= omega_max)
    om = om[mask]
    ch = ch[mask]
    F = F[mask]
    ln_om = np.log(om)
    span = max(np.log(omega_max / omega_min), 1e-300)
    omegaF = om * F
    omegaF_norm = omegaF / max(abs(trapz(omegaF, ln_om) / span), 1e-300)
    prod = omegaF * ch.real
    prod_norm = prod / max(abs(trapz(prod, ln_om) / span), 1e-300)
    fig, ax = plt.subplots(figsize=(7.8, 4.8))
    ax.semilogx(om, omegaF_norm, lw=2, label=r"$\omega F$")
    ax.semilogx(om, ch.real, lw=2, label=r"$\mathrm{Re}\,\widehat{\chi}$")
    ax.semilogx(om, np.abs(ch), lw=2, label=r"$|\widehat{\chi}|$")
    ax.semilogx(om, prod_norm, lw=2, label=r"$\omega F\mathrm{Re}\widehat{\chi}$")
    ax.set_xlabel(r"$\omega,\,\mathrm{s}^{-1}$")
    ax.set_ylabel(r"$A,\,1$")
    ax.legend(frameon=False)
    style_axes(ax)
    queue_fig(fig, fig_prefix(cfg.outdir, "03_spectral_ruler.png"))
    save_csv(fig_prefix(cfg.outdir, "03_spectral_ruler.csv"), ["omega", "F", "omegaF", "omegaF_norm", "Re_chihat", "Im_chihat", "Abs_chihat", "prod_norm"], [om, F, omegaF, omegaF_norm, ch.real, ch.imag, np.abs(ch), prod_norm])


