def attenuation_weights(cfg):
    ell_c = HBAR / np.sqrt(max(cfg.m * K_B * cfg.T, 1e-300))
    ell_eff = min(ell_c, cfg.L_v)
    Lam_coll = Lambda_coll(cfg)

    def Gamma_tot(Delta_x):
        return cfg.Gamma_phi_bg + 0.5 * Lam_coll * Delta_x ** 2

    w = []
    cum = 0.0
    for k in range(cfg.N_windows):
        cum += Gamma_tot(ell_eff) * cfg.delta_t
        w.append(np.exp(-cum))
        if k < cfg.N_windows - 1 and cfg.gap_time > 0.0:
            cum += cfg.Gamma_phi_bg * cfg.gap_time
    w = np.array(w, dtype=float)
    return w, float(np.sum(w)), float(np.sum(w ** 2))


