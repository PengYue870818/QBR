def approximate_Tchi_phys(tau0, tau_int, a_pp, g_dimless):
    c1 = -3.5 * a_pp
    c2 = 63.0 / 8.0 * a_pp ** 2 - 7.0 / 4.0 * g_dimless ** 2
    val = c1 * tau_int ** 3 / 6.0 + c2 * tau_int ** 4 / 12.0
    return tau0 ** 2 * val


