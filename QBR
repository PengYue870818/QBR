def classify_regime(cfg, structure_pass, rem_ratio_time, Tchi_band_rel_err, direct_strict_pass, convergence_pass):
    factorized_channel_exists = bool(structure_pass)
    factorized_channel_dominant = bool(structure_pass and rem_ratio_time <= cfg.remainder_accept)
    virtual_environment_needed = bool(structure_pass and rem_ratio_time > cfg.remainder_accept)
    band_mismatch_dominated = bool(np.isfinite(Tchi_band_rel_err) and Tchi_band_rel_err > 0.5)
    direct_model_mismatch = bool(structure_pass and cfg.direct_verify and not (direct_strict_pass and convergence_pass))
    if not factorized_channel_exists:
        regime = "no_factorized_channel"
    elif factorized_channel_dominant and not band_mismatch_dominated:
        regime = "factorization_dominant"
    elif band_mismatch_dominated and virtual_environment_needed:
        regime = "band_mismatch_plus_virtual_response"
    elif virtual_environment_needed:
        regime = "virtual_environment_response"
    elif band_mismatch_dominated:
        regime = "band_mismatch_dominated"
    else:
        regime = "factorized_channel_visible"
    return {
        "regime": regime,
        "factorized_channel_exists": factorized_channel_exists,
        "factorized_channel_dominant": factorized_channel_dominant,
        "virtual_environment_needed": virtual_environment_needed,
        "band_mismatch_dominated": band_mismatch_dominated,
        "direct_model_mismatch": direct_model_mismatch,
    }


def run_strict_verification(cfg):
    np.random.seed(cfg.seed)
    ensure_dir(cfg.outdir)
    v_th, p_th, epsilon, beta, tau0, tau_int = basic_scales(cfg)
    a_xx_tau, a_pp_tau = a_xx_a_pp_profiles(cfg, tau0, p_th, use_total=cfg.chi_use_total)
    _, sigma_diff2 = sigma_diff2_profile(tau_int, beta, a_xx_tau, a_pp_tau, n_steps=800, coeff_xx=cfg.kernel_sigma_xx_factor)
    sigma_state_dimless_max = float(np.sqrt(max(epsilon ** 2 + np.max(sigma_diff2), 0.0)))
    sigma_state_phys_max = cfg.L_v * sigma_state_dimless_max
    sigma_G_phys_max = np.sqrt(cfg.psf_width ** 2 + sigma_state_phys_max ** 2)
    omega_min, omega_max, Delta_meas, valid_band, v_eff = auto_adjust_band_if_needed(cfg, sigma_G_phys_max, v_th)
    if not valid_band:
        raise RuntimeError(f"invalid usable band: omega_min={omega_min}, omega_max={omega_max}, sigma_G_phys_max={sigma_G_phys_max}, v_eff={v_eff}")

    xi0, d1Vtilde, d3Vtilde, _ = build_potential(cfg, p_th)
    geom = compute_geometry(cfg, epsilon, xi0, d3Vtilde)

    if cfg.g_mode == "auto_psf":
        g_dimless = estimate_g_psf_weighted(geom["xi_grid"], geom["G"], d1Vtilde(geom["xi_grid"]))
    elif cfg.g_mode == "zero":
        g_dimless = 0.0
    else:
        g_dimless = float(cfg.g_value)

    chi_base = qbr_precompute_chi_base(cfg, tau0, tau_int, a_pp_tau(0.0), g_dimless)
    omega_min, omega_max, Delta_meas, Jres, band_report = qbr_precompute_best_band(cfg, omega_min, omega_max, chi_base)

    if not np.isfinite(omega_min) or not np.isfinite(omega_max) or omega_max <= omega_min:
        raise RuntimeError(f"invalid active band: omega_min={omega_min}, omega_max={omega_max}")
    if Jres["omega_grid"] is None:
        raise RuntimeError("Jres omega_grid is None")
    if not np.isfinite(Jres["J_realchi"]) or not np.isfinite(Jres["J_F"]) or not np.isfinite(Jres["Tchi_phys"]):
        raise RuntimeError("invalid spectral or time lever")

    if bool(getattr(cfg, "precompute_band_verbose", True)):
        print("=" * 120)
        print("[main-defense] final active band")
        print("omega_min:", omega_min)
        print("omega_max:", omega_max)
        print("Delta_meas:", Delta_meas)
        print("J_realchi:", Jres["J_realchi"])
        print("J_F:", Jres["J_F"])
        print("Tchi_phys:", Jres["Tchi_phys"])
        print("Tchi_from_band:", Jres["Tchi_from_band"])
        print("Tchi_band_rel_err:", Jres["Tchi_band_rel_err"])
        print("band_mode:", band_report.get("mode", "unknown"))
        print("=" * 120)

    J_meas = Jres["J_realchi"]
    J_F = Jres["J_F"]
    Tchi_time = Jres["Tchi_phys"]
    Tchi_band = Jres["Tchi_from_band"]
    delta_p1_main_time = -p_th * epsilon ** 2 * geom["K"] * Tchi_time
    delta_p1_main_band = -p_th * epsilon ** 2 * geom["K"] * Tchi_band
    delta_p1_ruler = -p_th * epsilon ** 2 * geom["K"] * J_F * Delta_meas

    ell_c = HBAR / np.sqrt(max(cfg.m * K_B * cfg.T, 1e-300))
    ell_eff = min(ell_c, cfg.L_v)
    gamma_tot_dt = (cfg.Gamma_phi_bg + 0.5 * Lambda_coll(cfg) * ell_eff ** 2) * cfg.delta_t
    tau_mem_ratio = cfg.tau_mem / max(cfg.delta_t, 1e-300)
    c_rel_dt = cfg.c_rel_rate * cfg.delta_t
    sigma_rel_dt = cfg.sigmaG_rel_rate * cfg.delta_t

    plot_geometry(cfg, geom)
    plot_time_kernel(cfg, Jres)
    plot_spectral(cfg, omega_min, omega_max, Jres)
    plot_band_consistency(cfg, omega_min, omega_max, Jres)
    slopeF_sup = plot_log_slope_omegaF(cfg, omega_min, omega_max)
    plot_window_filter(cfg, omega_min, omega_max)
    plot_hermite_basis(cfg)

    lambda_eta = a_pp_tau(0.0) * cfg.kappa_eta_IR ** 2 if cfg.kappa_eta_IR > 0.0 else 1e-12
    rem = compute_remainders(cfg, p_th, epsilon, cfg.delta_t, geom, Jres, lambda_eta)
    rem_total = sum(abs(rem[k]) for k in ["E_p", "E_a", "E_s", "E_f", "E_chi"])
    main_abs_time = abs(delta_p1_main_time)
    main_abs_band = abs(delta_p1_main_band)
    rem_ratio_time = rem_total / max(main_abs_time, 1e-300)
    rem_ratio_band = rem_total / max(main_abs_band, 1e-300)

    checks = validity_checks(cfg, epsilon, gamma_tot_dt, tau_mem_ratio, c_rel_dt, sigma_rel_dt, a_pp_tau(0.0), a_xx_tau(0.0), Jres, slopeF_sup, rem_ratio_time)
    chi_series = chi_series_validation(cfg, a_pp_tau(0.0), g_dimless, tau_int)
    plot_remainders(cfg, rem, main_abs_time, main_abs_band)
    plot_validity(cfg, checks)

    env_scan = environment_factorization_scan(cfg, geom, p_th, epsilon, tau0, tau_int, beta, g_dimless, omega_min, omega_max)

    fit_delta = plot_scan_delta(cfg, p_th, epsilon ** 2, geom["K"], Tchi_time)
    fit_eps2 = plot_scan_eps2(cfg, p_th, epsilon ** 2, geom["K"], Tchi_time)
    fit_K = plot_scan_K(cfg, p_th, epsilon ** 2, geom["K"], Tchi_time)

