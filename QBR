def environment_factorization_scan(cfg, base_geom, p_th, epsilon, tau0, tau_int, beta, g_dimless, omega_min, omega_max):
    factors = np.geomspace(cfg.env_scan_factor_min, cfg.env_scan_factor_max, int(cfg.env_scan_points))
    K_vals, T_vals, Tband_vals, a_vals, dp_vals, recovered = [], [], [], [], [], []
    for fac in factors:
        cfg2 = copy.deepcopy(cfg)
        cfg2.Gamma_s_const = cfg.Gamma_s_const * fac
        a_xx_tau2, a_pp_tau2 = a_xx_a_pp_profiles(cfg2, tau0, p_th, use_total=cfg2.chi_use_total)
        Jres2 = compute_chi_and_J(cfg2, tau0, tau_int, a_pp_tau2(0.0), g_dimless, omega_min, omega_max, cfg2.delta_t)
        K2 = base_geom["K"]
        T2 = Jres2["Tchi_phys"]
        Tband2 = Jres2["Tchi_from_band"]
        dp2 = -p_th * epsilon ** 2 * K2 * T2
