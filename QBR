def chi_series_validation(cfg, a_pp, g_dimless, tau_int):
    if a_pp <= 0:
        return {
            "chi_series_pass": False,
            "c1_fit": np.nan,
            "c2_fit": np.nan,
            "c1_theory": np.nan,
            "c2_theory": np.nan,
            "c1_rel_err": np.nan,
            "c2_rel_err": np.nan,
            "series_max_rel_err": np.nan,
        }
    u_max = min(0.04 * max(tau_int, 1e-300), 0.015 / max(a_pp, 1e-300), 0.08)
    us = np.linspace(u_max / 20.0, u_max, 28)
    chi_num, _, _, _, _, _, _ = chi_from_fft(cfg, us, a_pp, g_dimless)
    A = np.vstack([us, us ** 2]).T
    coeff, _, _, _ = np.linalg.lstsq(A, chi_num, rcond=None)
    c1_fit = float(coeff[0])
    c2_fit = float(coeff[1])
    c1_th = float(-3.5 * a_pp)
    c2_th = float(63.0 / 8.0 * a_pp ** 2 - 7.0 / 4.0 * g_dimless ** 2)
    chi_fit = c1_fit * us + c2_fit * us ** 2
    chi_series = c1_th * us + c2_th * us ** 2
    c1_rel = relative_error(c1_fit, c1_th)
    c2_rel = relative_error(c2_fit, c2_th) if abs(c2_th) > 1e-14 else abs(c2_fit - c2_th)
    series_rel = float(np.max(np.abs(chi_num - chi_series) / np.maximum(np.abs(chi_num), 1e-14)))
    passed = bool(c1_rel <= cfg.chi_series_rel_accept and series_rel <= 3.0 * cfg.chi_series_rel_accept)

    fig, ax = plt.subplots(figsize=(7.8, 4.8))
    ax.plot(us, chi_num, "o", ms=5, label=r"$\chi_{\mathrm{FFT}}$")
    ax.plot(us, chi_fit, "-", lw=2, label=r"$\chi_{\mathrm{fit}}$")
    ax.plot(us, chi_series, "--", lw=2, label=r"$\chi_{\mathrm{series}}$")
    ax.set_xlabel(r"$u,\,1$")
    ax.set_ylabel(r"$\chi,\,\mathrm{s}$")
    ax.legend(frameon=False)
    style_axes(ax)
    queue_fig(fig, fig_prefix(cfg.outdir, "08_chi_series_validation.png"))
    save_csv(fig_prefix(cfg.outdir, "08_chi_series_validation.csv"), ["u", "chi_fft", "chi_fit", "chi_series"], [us, chi_num, chi_fit, chi_series])

    return {
        "chi_series_pass": passed,
        "c1_fit": c1_fit,
        "c2_fit": c2_fit,
        "c1_theory": c1_th,
        "c2_theory": c2_th,
        "c1_rel_err": c1_rel,
        "c2_rel_err": c2_rel,
        "series_max_rel_err": series_rel,
    }


