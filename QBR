def safe_div(a, b):
    return float(a / np.sign(b if b != 0 else 1.0) / max(abs(b), 1e-300))


def relative_error(a, b):
    return float(abs(a - b) / max(abs(b), 1e-300))


def linear_fit(x, y):
    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)
    A = np.vstack([x, np.ones_like(x)]).T
    coeff, _, _, _ = np.linalg.lstsq(A, y, rcond=None)
    slope = float(coeff[0])
    intercept = float(coeff[1])
    yhat = slope * x + intercept
    ss_res = float(np.sum((y - yhat) ** 2))
    ss_tot = float(np.sum((y - np.mean(y)) ** 2))
    r2 = 1.0 if ss_tot <= 1e-300 else 1.0 - ss_res / ss_tot
    n = len(x)
    if n > 2:
        s2 = ss_res / max(n - 2, 1)
        xbar = float(np.mean(x))
        sxx = float(np.sum((x - xbar) ** 2))
        ci95 = float(1.96 * np.sqrt(s2 / max(sxx, 1e-300)))
    else:
        ci95 = np.nan
    return slope, intercept, r2, ci95, yhat


def filter_rectangular_double_sided(omega, delta_t):
    omega = np.asarray(omega, dtype=float)
    x = 0.5 * omega * float(delta_t)
    return 4.0 * np.sin(x) ** 2 / np.maximum(omega ** 2, 1e-300)


