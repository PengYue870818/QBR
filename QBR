def periodic_upwind_eta(W, a_eta, de):
    W = np.asarray(W, dtype=float)
    a_eta = np.asarray(a_eta, dtype=float)
    down = np.roll(W, 1, axis=0)
    up = np.roll(W, -1, axis=0)
    dminus = (W - down) / de
    dplus = (up - W) / de
    return np.where(a_eta[None, :] >= 0.0, dminus, dplus)


def upwind_xi_nonperiodic(W, a_xi, dx):
    W = np.asarray(W, dtype=float)
    a_xi = np.asarray(a_xi, dtype=float)
    left = np.empty_like(W)
    right = np.empty_like(W)
    left[:, 0] = W[:, 0]
    left[:, 1:] = W[:, :-1]
    right[:, -1] = W[:, -1]
    right[:, :-1] = W[:, 1:]
    dminus = (W - left) / dx
    dplus = (right - W) / dx
    return np.where(a_xi[:, None] >= 0.0, dminus, dplus)


def periodic_second_eta(W, de):
    W = np.asarray(W, dtype=float)
    return (np.roll(W, -1, axis=0) - 2.0 * W + np.roll(W, 1, axis=0)) / de ** 2


def second_xi_nonperiodic(W, dx):
    W = np.asarray(W, dtype=float)
    out = np.zeros_like(W)
    out[:, 1:-1] = (W[:, 2:] - 2.0 * W[:, 1:-1] + W[:, :-2]) / dx ** 2
    out[:, 0] = (W[:, 1] - W[:, 0]) / dx ** 2
    out[:, -1] = (W[:, -2] - W[:, -1]) / dx ** 2
    return out


def eta_third_derivative_fourier(W, eta, filter_strength=36.0, filter_power=16):
    W = np.asarray(W, dtype=float)
    eta = np.asarray(eta, dtype=float)
    n_eta = len(eta)
    d_eta = eta[1] - eta[0]
    k = 2.0 * np.pi * np.fft.fftfreq(n_eta, d=d_eta)
    W_hat = np.fft.fft(W, axis=0)
    if filter_strength is not None and filter_strength > 0.0:
        kmax = np.max(np.abs(k))
        if kmax > 0.0:
            filt = np.exp(-filter_strength * (np.abs(k) / kmax) ** filter_power)
            W_hat = W_hat * filt[:, None]
    d3_hat = ((1j * k)[:, None] ** 3) * W_hat
    return np.fft.ifft(d3_hat, axis=0).real


def normalize_wigner(W, xi, eta):
    total = integrate2d(W, xi, eta)
    if not np.isfinite(total) or abs(total) <= 1e-300:
        raise FloatingPointError("initial Wigner normalization failed")
    return W / total


def build_initial_wigner(cfg, xi, eta, xi0, epsilon):
    sigma_x = max(cfg.psf_width / max(cfg.L_v, 1e-300), epsilon, 1e-3)
    sigma_eta = 1.0
    X, E = np.meshgrid(xi, eta)
    W = np.exp(-0.5 * ((X - xi0) / sigma_x) ** 2) * np.exp(-0.5 * (E / sigma_eta) ** 2)
    W = normalize_wigner(W, xi, eta)
    if not np.all(np.isfinite(W)):
        raise FloatingPointError("initial Wigner contains non-finite values")
    return W


def compute_direct_delta_p1_from_integrand(integrand_t, taus, p_th, epsilon, tau0):
    integrand_t = np.asarray(integrand_t, dtype=float)
    taus = np.asarray(taus, dtype=float)
    if not np.all(np.isfinite(integrand_t)):
        raise FloatingPointError("direct integrand contains non-finite values")
    return float(-p_th * epsilon ** 2 * tau0 * trapz(integrand_t, taus))


def direct_force_integrand(W2, xi, eta, d1V_vals_xi):
    val = d1V_vals_xi[None, :] * W2
    if not np.all(np.isfinite(val)):
        raise FloatingPointError("non-finite direct force integrand")
    return float(integrate2d(val, xi, eta))


def solve_w0_w2_direct(cfg, p_th, epsilon, beta, tau0, tau_int, a_xx_val, a_pp_val, xi0, d1Vtilde, d3Vtilde, source_amp=1.0, enable_W2=True, max_cfl=0.04, filter_d3=True):
    n_xi = int(max(cfg.pde_n_xi, 33))
    n_eta = int(max(cfg.pde_n_eta, 64))
    xi = np.linspace(xi0 - cfg.pde_xi_half_width, xi0 + cfg.pde_xi_half_width, n_xi, endpoint=True)
    eta = np.linspace(-cfg.pde_eta_max, cfg.pde_eta_max, n_eta, endpoint=False)
    dx = float(xi[1] - xi[0])
    de = float(eta[1] - eta[0])
    d1x = d1Vtilde(xi)
    d3x = d3Vtilde(xi)
    a_xi = eta / max(beta, 1e-300)
    a_eta = np.zeros_like(xi)
    ##a_eta = -d1x
    max_ax = max(float(np.max(np.abs(a_xi))), 1e-12)
    max_ae = max(float(np.max(np.abs(a_eta))), 1e-12)
    dt_adv_x = dx / max_ax
    dt_adv_e = de / max_ae
    dt_diff_e = 0.5 * de ** 2 / max(a_pp_val, 1e-300) if a_pp_val > 0.0 else np.inf
    dt_diff_x = 0.5 * dx ** 2 / max(a_xx_val, 1e-300) if a_xx_val > 0.0 else np.inf
    cfl = min(float(cfg.pde_cfl), float(max_cfl))
    dt_safe = cfl * min(dt_adv_x, dt_adv_e, dt_diff_e, dt_diff_x, tau_int if tau_int > 0.0 else np.inf)
    if not np.isfinite(dt_safe) or dt_safe <= 0.0:
        raise FloatingPointError("invalid dt_safe in direct solver")
    n_t = max(int(np.ceil(tau_int / dt_safe)), 1)
    taus = np.linspace(0.0, tau_int, n_t + 1)
    dt = float(taus[1] - taus[0])
    W0 = build_initial_wigner(cfg, xi, eta, xi0, epsilon)
    W2 = np.zeros_like(W0)
    W0_mass_hist = np.zeros(n_t + 1, dtype=float)
    W2_mass_hist = np.zeros(n_t + 1, dtype=float)
    integrand_t = np.zeros(n_t + 1, dtype=float)
    W0_mass_hist[0] = integrate2d(W0, xi, eta)
    W2_mass_hist[0] = integrate2d(W2, xi, eta)
    integrand_t[0] = direct_force_integrand(W2, xi, eta, d1x)
    d3_filter_strength = 36.0 if filter_d3 else None
    for it in range(n_t):
        dW0_dxi = upwind_xi_nonperiodic(W0, a_xi, dx)
        dW0_deta = periodic_upwind_eta(W0, a_eta, de)
        rhs0 = -(a_xi[:, None] * dW0_dxi) - (a_eta[None, :] * dW0_deta)
        if a_pp_val > 0.0:
            rhs0 += a_pp_val * periodic_second_eta(W0, de)
        if a_xx_val > 0.0:
            rhs0 += a_xx_val * second_xi_nonperiodic(W0, dx)
        W0_next = W0 + dt * rhs0
        if not np.all(np.isfinite(W0_next)):
            raise FloatingPointError(f"W0 became non-finite at step={it}, tau={taus[it]:.6e}")
        if enable_W2:
            dW2_dxi = upwind_xi_nonperiodic(W2, a_xi, dx)
            dW2_deta = periodic_upwind_eta(W2, a_eta, de)
            rhs2 = -(a_xi[:, None] * dW2_dxi) - (a_eta[None, :] * dW2_deta)
            if a_pp_val > 0.0:
                rhs2 += a_pp_val * periodic_second_eta(W2, de)
            if a_xx_val > 0.0:
                rhs2 += a_xx_val * second_xi_nonperiodic(W2, dx)
            d3etaW0 = eta_third_derivative_fourier(W0, eta, filter_strength=d3_filter_strength, filter_power=16)
            if not np.all(np.isfinite(d3etaW0)):
                raise FloatingPointError(f"d3etaW0 became non-finite at step={it}, tau={taus[it]:.6e}")
            source = source_amp * (-(1.0 / 24.0) * d3x[None, :] * d3etaW0)
            W2_next = W2 + dt * (rhs2 + source)
            if not np.all(np.isfinite(W2_next)):
                raise FloatingPointError(f"W2 became non-finite at step={it}, tau={taus[it]:.6e}")
        else:
            W2_next = W2.copy()
        W0 = W0_next
        W2 = W2_next
        W0_mass_hist[it + 1] = integrate2d(W0, xi, eta)
        W2_mass_hist[it + 1] = integrate2d(W2, xi, eta)
        integrand_t[it + 1] = direct_force_integrand(W2, xi, eta, d1x)
    delta_p1_num = compute_direct_delta_p1_from_integrand(integrand_t, taus, p_th, epsilon, tau0)
    W0_mass_drift = float(np.max(np.abs(W0_mass_hist - W0_mass_hist[0])))
    W2_mass_drift = float(np.max(np.abs(W2_mass_hist - W2_mass_hist[0])))
    return {
        "xi": xi,
        "eta": eta,
        "W0_final": W0,
        "W2_final": W2,
        "taus": taus,
        "integrand_t": integrand_t,
        "delta_p1_num": float(delta_p1_num),
        "W0_mass_hist": W0_mass_hist,
        "W2_mass_hist": W2_mass_hist,
        "W0_mass_drift": W0_mass_drift,
        "W2_mass_drift": W2_mass_drift,
        "n_t_used": int(n_t),
        "dt_used": float(dt),
        "dt_adv_x": float(dt_adv_x),
        "dt_adv_e": float(dt_adv_e),
        "dt_diff_e": float(dt_diff_e),
        "dt_diff_x": float(dt_diff_x) if np.isfinite(dt_diff_x) else np.inf,
    }

def w_d3_analytic_eta(x):
    x = np.asarray(x, dtype=float)
    phi = np.exp(-0.5 * x ** 2) / np.sqrt(2.0 * np.pi)
    He6 = x ** 6 - 15.0 * x ** 4 + 45.0 * x ** 2 - 15.0
    return -He6 * phi


def chi_from_gauss_hermite_independent(cfg, taus, a_pp, g_dimless):
    """
    独立 reduced-channel chi 求解器。

    主链路 chi_from_fft 使用 Fourier spectral 半群：
        exp(-a_pp tau k^2) exp(-i g tau k)

    这里不用 FFT，而用 Gauss-Hermite 卷积公式：
        exp(a tau d_eta^2 - g tau d_eta) w(eta)
        = E[w(eta - g tau + sqrt(2 a tau) Z)]

    并直接对三阶导数形式积分：
        chi(tau) = ∫ phi [E[w'''(...)] - w'''] d eta / ∫ phi w''' d eta

    这条路径不复用 Jres["chi_t"]。
    """
    taus = np.asarray(taus, dtype=float)

    n_eta = int(max(getattr(cfg, "independent_n_eta", 2001), 101))
    eta_max = float(max(getattr(cfg, "independent_eta_max", cfg.J_eta_max), 4.0))
    gh_n = int(max(getattr(cfg, "independent_gh_n", 64), 8))

    eta = np.linspace(-eta_max, eta_max, n_eta)
    phi_eta = np.exp(-0.5 * eta ** 2) / np.sqrt(2.0 * np.pi)
    d3w_eta = w_d3_analytic_eta(eta)

    denom = trapz(phi_eta * d3w_eta, eta)

    xg, wg = np.polynomial.hermite.hermgauss(gh_n)
    vals = np.zeros_like(taus, dtype=float)

    for j, tau in enumerate(taus):
        tau = float(tau)

        if tau <= 0.0:
            vals[j] = 0.0
            continue

        shift = eta - g_dimless * tau

        if a_pp > 0.0:
            sigma = 2.0 * np.sqrt(a_pp * tau)
            acc = np.zeros_like(eta)
            for xgi, wgi in zip(xg, wg):
                acc += wgi * w_d3_analytic_eta(shift + sigma * xgi)
            evolved_d3w = acc / np.sqrt(np.pi)
        else:
            evolved_d3w = w_d3_analytic_eta(shift)

        vals[j] = trapz(phi_eta * (evolved_d3w - d3w_eta), eta) / max(denom, 1e-300)

    denom_ref = 15.0 / (16.0 * np.sqrt(np.pi))
    denom_rel_err = abs(denom - denom_ref) / max(abs(denom_ref), 1e-300)

    return {
        "taus": taus,
        "chi_t": vals,
        "eta": eta,
        "phi": phi_eta,
        "d3w": d3w_eta,
        "denom": float(denom),
        "denom_ref": float(denom_ref),
        "denom_rel_err": float(denom_rel_err),
    }

def compute_K_independent_legendre(cfg, epsilon, xi0, d3Vtilde):
    """
    独立空间几何因子 K 求解器。

    主链路 compute_geometry 用 uniform grid + trapz。
    这里用 Gauss-Legendre quadrature。

    这样 direct 验证不直接复用 geom["K"]。
    """
    C_K = 1.0 / (8.0 * np.sqrt(np.pi))
    sigma_psf = max(cfg.psf_width / max(cfg.L_v, 1e-300), 1e-12)

    n = int(max(getattr(cfg, "independent_K_legendre_n", 1200), 64))

    a = xi0 - 12.0 * sigma_psf
    b = xi0 + 12.0 * sigma_psf

    xg, wg = np.polynomial.legendre.leggauss(n)
    xi = 0.5 * (b - a) * xg + 0.5 * (b + a)
    weights = 0.5 * (b - a) * wg

    G = psf_profile(cfg, xi, xi0, sigma_psf)
    n0 = G.copy() if cfg.psf_matched else _psf_profile(
        xi,
        xi0,
        max(epsilon, 1e-12),
        cfg.psf_norm_mode,
    )

    d3_vals = d3Vtilde(xi)

    A0 = 15.0 / 48.0 * float(np.sum(weights * G * n0))
    S = float(np.sum(weights * G * d3_vals))
    K = C_K * A0 * S

    return {
        "K": float(K),
        "A0": float(A0),
        "S": float(S),
        "C_K": float(C_K),
        "xi": xi,
        "weights": weights,
        "G": G,
        "n0": n0,
        "d3_vals": d3_vals,
    }

def solve_independent_reduced_direct(
    cfg,
    p_th,
    epsilon,
    tau0,
    tau_int,
    xi0,
    d3Vtilde,
    a_pp,
    g_dimless,
):
    """
    强独立约化通道 direct 验证。

    不用 Jres["chi_t"]。
    不用 FFT。
    不直接用 geom["K"]。
    不调用 solve_factorized_direct_from_chi。

    它验证的是同一个 reduced factorized channel：
        delta p1 = -p_th * epsilon^2 * K * tau0^2 ∫(tau_int - tau) chi(tau) d tau

    但 K 和 chi 都由独立数值路径获得。
    """
    Nt = int(max(getattr(cfg, "independent_n_t", 1024), 16))
    taus = np.linspace(0.0, float(tau_int), Nt)

    Kres = compute_K_independent_legendre(
        cfg,
        epsilon,
        xi0,
        d3Vtilde,
    )

    chi_res = chi_from_gauss_hermite_independent(
        cfg,
        taus,
        a_pp,
        g_dimless,
    )

    K_ind = Kres["K"]
    chi_ind = chi_res["chi_t"]

    integrand_t = K_ind * tau0 * (tau_int - taus) * chi_ind

    delta_p1_num = compute_direct_delta_p1_from_integrand(
        integrand_t,
        taus,
        p_th,
        epsilon,
        tau0,
    )

    Tchi_dimless_ind = trapz((tau_int - taus) * chi_ind, taus)
    Tchi_phys_ind = tau0 ** 2 * Tchi_dimless_ind

    # 这里只是为了兼容原来的 plot_direct_verification。
    # 这个 solver 是 reduced-channel solver，不产生真实二维 W0/W2 图。
    xi_plot = np.array([-0.5, 0.5], dtype=float)
    eta_plot = np.array([-0.5, 0.5], dtype=float)
    W0_final = np.ones((2, 2), dtype=float)
    W2_final = np.zeros((2, 2), dtype=float)
    mass = np.ones_like(taus, dtype=float)

    return {
        "xi": xi_plot,
        "eta": eta_plot,
        "W0_final": W0_final,
        "W2_final": W2_final,
        "taus": taus,
        "integrand_t": integrand_t,
        "chi_independent": chi_ind,
        "K_independent": float(K_ind),
        "A0_independent": float(Kres["A0"]),
        "S_independent": float(Kres["S"]),
        "Tchi_dimless_independent": float(Tchi_dimless_ind),
        "Tchi_phys_independent": float(Tchi_phys_ind),
        "delta_p1_num": float(delta_p1_num),
        "W0_mass_hist": mass,
        "W2_mass_hist": np.zeros_like(taus, dtype=float),
        "W0_mass_drift": 0.0,
        "W2_mass_drift": 0.0,
        "n_t_used": int(len(taus) - 1),
        "dt_used": float(taus[1] - taus[0]),
        "dt_adv_x": np.inf,
        "dt_adv_e": np.inf,
        "dt_diff_e": np.inf,
        "dt_diff_x": np.inf,
        "chi_denom_independent": float(chi_res["denom"]),
        "chi_denom_ref_independent": float(chi_res["denom_ref"]),
        "chi_denom_rel_err_independent": float(chi_res["denom_rel_err"]),
    }

def run_independent_reduced_convergence(
    cfg,
    p_th,
    epsilon,
    tau0,
    tau_int,
    xi0,
    d3Vtilde,
    a_pp,
    g_dimless,
):
    if not cfg.direct_convergence:
        return {
            "convergence_pass": False,
            "convergence_rel_change": np.nan,
        }

    cfg_low = copy.deepcopy(cfg)
    cfg_low.independent_n_eta = max(801, int(cfg.independent_n_eta * 0.60))
    cfg_low.independent_n_t = max(384, int(cfg.independent_n_t * 0.60))
    cfg_low.independent_gh_n = max(32, int(cfg.independent_gh_n * 0.75))
    cfg_low.independent_K_legendre_n = max(500, int(cfg.independent_K_legendre_n * 0.60))

    cfg_high = copy.deepcopy(cfg)

    res_low = solve_independent_reduced_direct(
        cfg_low,
        p_th,
        epsilon,
        tau0,
        tau_int,
        xi0,
        d3Vtilde,
        a_pp,
        g_dimless,
    )

    res_high = solve_independent_reduced_direct(
        cfg_high,
        p_th,
        epsilon,
        tau0,
        tau_int,
        xi0,
        d3Vtilde,
        a_pp,
        g_dimless,
    )

    vals = [res_low["delta_p1_num"], res_high["delta_p1_num"]]
    labels = [
        f"eta={cfg_low.independent_n_eta},t={cfg_low.independent_n_t},gh={cfg_low.independent_gh_n}",
        f"eta={cfg_high.independent_n_eta},t={cfg_high.independent_n_t},gh={cfg_high.independent_gh_n}",
    ]

    rel_change = abs(vals[-1] - vals[0]) / max(abs(vals[-1]), 1e-300)
    passed = bool(rel_change <= cfg.convergence_accept)

    fig, ax = plt.subplots(figsize=(7.8, 4.8))
    ax.plot(np.arange(len(vals)), vals, "o-", lw=2)
    ax.set_xticks(np.arange(len(vals)))
    ax.set_xticklabels(labels, rotation=12)
    ax.set_xlabel(r"$N_{\eta},N_t,N_{\mathrm{GH}},\,1$")
    ax.set_ylabel(r"$\delta p_1,\,\mathrm{kg}\,\mathrm{m}\,\mathrm{s}^{-1}$")
    style_axes(ax)

    queue_fig(fig, fig_prefix(cfg.outdir, "20_independent_reduced_convergence.png"))

    save_csv(
        fig_prefix(cfg.outdir, "20_independent_reduced_convergence.csv"),
        ["grid", "delta_p1"],
        [labels, vals],
    )

    return {
        "convergence_pass": passed,
        "convergence_rel_change": float(rel_change),
    }

def solve_factorized_direct_from_chi(cfg, p_th, epsilon, tau0, tau_int, K, Jres):
    taus = np.asarray(Jres["taus"], dtype=float)
    chi_t = np.asarray(Jres["chi_t"], dtype=float)
    if len(taus) != len(chi_t):
        raise ValueError("taus and chi_t length mismatch in solve_factorized_direct_from_chi")
    if len(taus) < 2:
        raise ValueError("not enough time points in solve_factorized_direct_from_chi")
    integrand_t = K * tau0 * (tau_int - taus) * chi_t
    delta_p1_num = compute_direct_delta_p1_from_integrand(
        integrand_t,
        taus,
        p_th,
        epsilon,
        tau0,
    )
    xi = np.array([-0.5, 0.5], dtype=float)
    eta = np.array([-0.5, 0.5], dtype=float)
    W0_final = np.ones((2, 2), dtype=float)
    W2_final = np.zeros((2, 2), dtype=float)
    mass = np.ones_like(taus, dtype=float)
    return {
        "xi": xi,
        "eta": eta,
        "W0_final": W0_final,
        "W2_final": W2_final,
        "taus": taus,
        "integrand_t": integrand_t,
        "delta_p1_num": float(delta_p1_num),
        "W0_mass_hist": mass,
        "W2_mass_hist": np.zeros_like(taus, dtype=float),
        "W0_mass_drift": 0.0,
        "W2_mass_drift": 0.0,
        "n_t_used": int(len(taus) - 1),
        "dt_used": float(taus[1] - taus[0]),
        "dt_adv_x": np.inf,
        "dt_adv_e": np.inf,
        "dt_diff_e": np.inf,
        "dt_diff_x": np.inf,
    }


def run_direct_strict_suite(cfg, p_th, epsilon, beta, tau0, tau_int, a_xx_val, a_pp_val, xi0, d1Vtilde, d3Vtilde):
    res_w0_only = solve_w0_w2_direct(cfg, p_th, epsilon, beta, tau0, tau_int, a_xx_val, a_pp_val, xi0, d1Vtilde, d3Vtilde, source_amp=0.0, enable_W2=False)
    res_src0 = solve_w0_w2_direct(cfg, p_th, epsilon, beta, tau0, tau_int, a_xx_val, a_pp_val, xi0, d1Vtilde, d3Vtilde, source_amp=0.0, enable_W2=True)
    amps = [0.5, 1.0, 2.0]
    linear_results = [solve_w0_w2_direct(cfg, p_th, epsilon, beta, tau0, tau_int, a_xx_val, a_pp_val, xi0, d1Vtilde, d3Vtilde, source_amp=a, enable_W2=True) for a in amps]
    d0 = res_src0["delta_p1_num"]
    d05 = linear_results[0]["delta_p1_num"]
    d10 = linear_results[1]["delta_p1_num"]
    d20 = linear_results[2]["delta_p1_num"]
    lin_err_05 = abs(d05 - 0.5 * d10) / max(abs(d10), 1e-300)
    lin_err_20 = abs(d20 - 2.0 * d10) / max(abs(d10), 1e-300)
    lin_err = max(float(lin_err_05), float(lin_err_20))
    max_W0_mass_drift = max(res_w0_only["W0_mass_drift"], res_src0["W0_mass_drift"], linear_results[0]["W0_mass_drift"], linear_results[1]["W0_mass_drift"], linear_results[2]["W0_mass_drift"])
    pass_w0_mass = max_W0_mass_drift <= cfg.direct_mass_accept
    pass_source_zero = abs(d0) <= max(1e-12 * abs(d10), 1e-300)
    pass_linearity = lin_err <= cfg.direct_linearity_accept
    summary = {
        "direct_strict_pass": bool(pass_w0_mass and pass_source_zero and pass_linearity),
        "delta_source_0": float(d0),
        "delta_source_0p5": float(d05),
        "delta_source_1": float(d10),
        "delta_source_2": float(d20),
        "source_zero_abs": float(abs(d0)),
        "linearity_rel_err": float(lin_err),
        "linearity_rel_err_0p5": float(lin_err_05),
        "linearity_rel_err_2": float(lin_err_20),
        "max_W0_mass_drift": float(max_W0_mass_drift),
        "pass_W0_mass": bool(pass_w0_mass),
        "pass_source_zero": bool(pass_source_zero),
        "pass_linearity": bool(pass_linearity),
        "n_t_used": int(linear_results[1]["n_t_used"]),
        "dt_used": float(linear_results[1]["dt_used"]),
    }
    return {"main": linear_results[1], "summary": summary, "linear": linear_results, "source_0": res_src0, "w0_only": res_w0_only}


def run_direct_convergence(cfg, p_th, epsilon, beta, tau0, tau_int, a_xx_val, a_pp_val, xi0, d1Vtilde, d3Vtilde):
    if not cfg.direct_convergence:
        return {"convergence_pass": False, "convergence_rel_change": np.nan}
    base_nx = max(121, int(cfg.pde_n_xi * 0.70))
    base_ne = max(80, int(cfg.pde_n_eta * 0.70))
    settings = [(base_nx, base_ne, 0.05), (cfg.pde_n_xi, cfg.pde_n_eta, cfg.pde_cfl)]
    vals, labels = [], []
    for nx, ne, cfl in settings:
        cfg2 = copy.deepcopy(cfg)
        cfg2.pde_n_xi = int(nx)
        cfg2.pde_n_eta = int(ne)
        cfg2.pde_cfl = float(cfl)
        res = solve_w0_w2_direct(cfg2, p_th, epsilon, beta, tau0, tau_int, a_xx_val, a_pp_val, xi0, d1Vtilde, d3Vtilde, source_amp=1.0, enable_W2=True)
        vals.append(res["delta_p1_num"])
        labels.append(f"{nx}x{ne}")
    rel_change = abs(vals[-1] - vals[0]) / max(abs(vals[-1]), 1e-300)
    passed = bool(rel_change <= cfg.convergence_accept)
    fig, ax = plt.subplots(figsize=(7.8, 4.8))
    ax.plot(np.arange(len(vals)), vals, "o-", lw=2)
    ax.set_xticks(np.arange(len(vals)))
    ax.set_xticklabels(labels)
    ax.set_xlabel(r"$N_\xi\times N_\eta,\,1$")
    ax.set_ylabel(r"$\delta p_1,\,\mathrm{kg}\,\mathrm{m}\,\mathrm{s}^{-1}$")
    style_axes(ax)
    queue_fig(fig, fig_prefix(cfg.outdir, "20_direct_convergence.png"))
    save_csv(fig_prefix(cfg.outdir, "20_direct_convergence.csv"), ["grid", "delta_p1"], [labels, vals])
    return {"convergence_pass": passed, "convergence_rel_change": float(rel_change)}


