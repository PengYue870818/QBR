PENDING_FIGS = []


def ensure_dir(d):
    if d and not os.path.isdir(d):
        os.makedirs(d, exist_ok=True)
    return d


def fig_prefix(outdir, tag):
    return os.path.join(outdir, tag)


def trapz(y, x):
    return np.trapezoid(np.asarray(y), np.asarray(x, dtype=float))


def integrate2d(f, x, y):
    f = np.asarray(f, dtype=float)
    return float(np.trapezoid(np.trapezoid(f, np.asarray(x, dtype=float), axis=1), np.asarray(y, dtype=float), axis=0))


def save_csv(path, headers, columns):
    ensure_dir(os.path.dirname(path))
    arrays = []
    lengths = []
    for c in columns:
        if np.isscalar(c) and not isinstance(c, str):
            arr = np.array([c], dtype=object)
        else:
            arr = np.array(c, dtype=object).reshape(-1)
        arrays.append(arr)
        lengths.append(arr.shape[0])
    n = max(lengths) if lengths else 0
    cols = []
    for arr in arrays:
        if arr.shape[0] == n:
            cols.append(arr)
        elif arr.shape[0] == 1 and n > 1:
            cols.append(np.full(n, arr[0], dtype=object))
        else:
            raise ValueError("column length mismatch")
    with open(path, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.writer(f)
        w.writerow(headers)
        for i in range(n):
            row = []
            for col in cols:
                v = col[i]
                if isinstance(v, (np.bool_, bool)):
                    row.append(bool(v))
                else:
                    try:
                        row.append(float(v))
                    except Exception:
                        row.append(str(v))
            w.writerow(row)


def queue_fig(fig, path):
    ensure_dir(os.path.dirname(path))
    PENDING_FIGS.append((fig, path))


def flush_all_figs():
    for fig, path in PENDING_FIGS:
        fig.savefig(path, dpi=300, bbox_inches="tight")
        fig.clf()
        plt.close(fig)
    PENDING_FIGS.clear()


