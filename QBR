def basic_scales(cfg):
    v_th = np.sqrt(K_B * cfg.T / max(cfg.m, 1e-300))
    p_th = cfg.m * v_th
    epsilon = HBAR / max(cfg.L_v * p_th, 1e-300)
    tau0 = cfg.L_v / max(abs(cfg.v_loc), 1e-300)
    beta = max(abs(cfg.v_loc) / max(v_th, 1e-300), 1e-300)
    tau_int = cfg.delta_t / max(tau0, 1e-300)
    return v_th, p_th, epsilon, beta, tau0, tau_int


def Lambda_coll(cfg):
    k = 2.0 * np.pi / max(cfg.lambda_opt, 1e-300)
    return max(cfg.alpha_coll, 0.0) * k ** 2 * max(cfg.Gamma_s_const, 0.0) * max(cfg.kappa_phi_sq, 0.0)


def Dpp_total(cfg):
    return max(cfg.Dpp_bg, 0.0) + 0.5 * HBAR ** 2 * max(Lambda_coll(cfg), 0.0)


def Dxx_total(cfg):
    return max(cfg.Dxx_bg, 0.0)


def a_xx_a_pp_profiles(cfg, tau0, p_th, use_total=True):
    Dpp = Dpp_total(cfg) if use_total else max(cfg.Dpp_bg, 0.0)
    Dxx = Dxx_total(cfg) if use_total else max(cfg.Dxx_bg, 0.0)
    a_pp = Dpp * tau0 / max(p_th ** 2, 1e-300)
    a_xx = Dxx * tau0 / max(cfg.L_v ** 2, 1e-300)
    return lambda _tau: float(a_xx), lambda _tau: float(a_pp)


def sigma_diff2_profile(tau_int, beta, a_xx_tau, a_pp_tau, n_steps=800, coeff_xx=1.0):
    taus = np.linspace(0.0, float(tau_int), int(max(n_steps, 2)))
    d_tau = taus[1] - taus[0]
    a_xx_vals = np.array([a_xx_tau(t) for t in taus], dtype=float)
    a_pp_vals = np.array([a_pp_tau(t) for t in taus], dtype=float)
    int_xx = np.cumsum(a_xx_vals) * d_tau * float(coeff_xx)
    int_pp = np.zeros_like(taus)
    for i, tau in enumerate(taus):
        s = taus[: i + 1]
        app = a_pp_vals[: i + 1]
        int_pp[i] = 2.0 * np.sum((tau - s) * app) * d_tau / max(beta ** 2, 1e-300)
    return taus, int_xx + int_pp


def _psf_profile(xi, mu, sigma, mode):
    xi = np.asarray(xi, dtype=float)
    sigma = max(float(sigma), 1e-300)
    if mode == "L1":
        return np.exp(-((xi - mu) ** 2) / (2.0 * sigma ** 2)) / (np.sqrt(2.0 * np.pi) * sigma)
    return np.pi ** (-0.25) * sigma ** (-0.5) * np.exp(-((xi - mu) ** 2) / (2.0 * sigma ** 2))


def psf_profile(cfg, xi, mu, sigma):
    return _psf_profile(xi, mu, sigma, cfg.psf_norm_mode)


def build_potential(cfg, p_th):
    xi0 = cfg.x0 / max(cfg.L_v, 1e-300)
    vloc_abs = max(abs(cfg.v_loc), 1e-300)
    if cfg.baseline_gaussian_A_eff:
        L_eff = np.sqrt(cfg.L_v ** 2 + cfg.psf_width ** 2)
        A_eff = cfg.L_v / max(L_eff, 1e-300) * cfg.V0_J / max(p_th * vloc_abs, 1e-300)

        def d1Vtilde(xi):
            x = np.asarray(xi, dtype=float)
            return -2.0 * A_eff * x * np.exp(-x ** 2)

        def d3Vtilde(xi):
            x = np.asarray(xi, dtype=float)
            return A_eff * (12.0 * x - 8.0 * x ** 3) * np.exp(-x ** 2)

        return xi0, d1Vtilde, d3Vtilde, A_eff

    s = cfg.L_v / max(cfg.psf_width, 1e-300)
    A = cfg.V0_J / max(p_th * vloc_abs, 1e-300) / np.sqrt(np.pi)

    def d1Vtilde(xi):
        x = np.asarray(xi, dtype=float)
        return -2.0 * A * s ** 2 * x * np.exp(-(s ** 2) * x ** 2)

    def d3Vtilde(xi):
        x = np.asarray(xi, dtype=float)
        return A * (12.0 * s ** 4 * x - 8.0 * s ** 6 * x ** 3) * np.exp(-(s ** 2) * x ** 2)

    return xi0, d1Vtilde, d3Vtilde, A


def compute_geometry(cfg, epsilon, xi0, d3Vtilde):
    C_K = 1.0 / (8.0 * np.sqrt(np.pi))
    sigma_psf = max(cfg.psf_width / max(cfg.L_v, 1e-300), 1e-12)
    xi_grid = np.linspace(xi0 - 12.0 * sigma_psf, xi0 + 12.0 * sigma_psf, 5001)
    G = psf_profile(cfg, xi_grid, xi0, sigma_psf)
    n0 = G.copy() if cfg.psf_matched else _psf_profile(xi_grid, xi0, max(epsilon, 1e-12), cfg.psf_norm_mode)
    A0 = 15.0 / 48.0 * trapz(G * n0, xi_grid)
    d3_vals = d3Vtilde(xi_grid)
    S = trapz(G * d3_vals, xi_grid)
    K = C_K * A0 * S
    rho_perp = 15.0 / 48.0 * n0 - A0 * G
    rho_perp_L2 = np.sqrt(max(trapz(rho_perp ** 2, xi_grid), 0.0))
    V3L2 = np.sqrt(max(trapz(d3_vals ** 2, xi_grid), 0.0))
    G_L2 = trapz(G ** 2, xi_grid)
    return {
        "C_K": float(C_K),
        "A0": float(A0),
        "S": float(S),
        "K": float(K),
        "xi_grid": xi_grid,
        "G": G,
        "n0": n0,
        "d3_vals": d3_vals,
        "rho_perp": rho_perp,
        "rho_perp_L2": float(rho_perp_L2),
        "V3L2": float(V3L2),
        "G_L2": float(G_L2),
    }


def estimate_g_psf_weighted(xi_grid, G, d1_vals):
    return trapz(G * d1_vals, xi_grid) / max(trapz(G, xi_grid), 1e-300)


def compute_band(cfg, sigma_G_phys_max, v_th):
    v_eff = max(abs(cfg.v_loc), 1e-300) if cfg.v_eff_mode == "loc" else max(v_th, 1e-300)
    omega_min = max(1.0 / max(cfg.delta_t, 1e-300), v_eff / max(cfg.L_v, 1e-300))
    candidates = []
    if np.isfinite(cfg.omega_sys) and cfg.omega_sys > 0.0:
        candidates.append(cfg.omega_sys)
    if np.isfinite(cfg.c_kappa) and cfg.c_kappa > 0.0:
        candidates.append(cfg.c_kappa / max(cfg.delta_t, 1e-300))
    candidates.append(v_eff / max(sigma_G_phys_max, 1e-300))
    omega_max = float(min(candidates))
    valid = bool(np.isfinite(omega_max) and omega_max > omega_min)
    Delta = float(np.log(omega_max / omega_min)) if valid else np.nan
    return float(omega_min), float(omega_max), Delta, valid, float(v_eff)


def auto_adjust_band_if_needed(cfg, sigma_G_phys_max, v_th):
    omega_min, omega_max, Delta, valid_band, v_eff = compute_band(cfg, sigma_G_phys_max, v_th)
    if valid_band or not cfg.auto_adjust_band:
        return omega_min, omega_max, Delta, valid_band, v_eff
    trial_sets = [
        {"v_loc": 2.0e-3, "delta_t": 5.0e-3, "psf_width": 0.2e-6},
        {"v_loc": 3.0e-3, "delta_t": 8.0e-3, "psf_width": 0.15e-6},
        {"v_loc": 5.0e-3, "delta_t": 1.0e-2, "psf_width": 0.1e-6},
    ]
    for trial in trial_sets:
        cfg.v_loc = float(trial["v_loc"])
        cfg.delta_t = float(trial["delta_t"])
        cfg.psf_width = float(trial["psf_width"])
        v_th2, p_th2, epsilon2, beta2, tau02, tau_int2 = basic_scales(cfg)
        a_xx_tau2, a_pp_tau2 = a_xx_a_pp_profiles(cfg, tau02, p_th2, use_total=cfg.chi_use_total)
        _, sigma_diff22 = sigma_diff2_profile(tau_int2, beta2, a_xx_tau2, a_pp_tau2, n_steps=800, coeff_xx=cfg.kernel_sigma_xx_factor)
        sigma_state_dimless_max2 = float(np.sqrt(max(epsilon2 ** 2 + np.max(sigma_diff22), 0.0)))
        sigma_state_phys_max2 = cfg.L_v * sigma_state_dimless_max2
        sigma_G_phys_max2 = np.sqrt(cfg.psf_width ** 2 + sigma_state_phys_max2 ** 2)
        omega_min, omega_max, Delta, valid_band, v_eff = compute_band(cfg, sigma_G_phys_max2, v_th2)
        if valid_band:
            return omega_min, omega_max, Delta, valid_band, v_eff
    return omega_min, omega_max, Delta, valid_band, v_eff


def hermite_objects(N, eta_max):
    L = 2.0 * float(eta_max)
    d_eta = L / N
    eta = np.linspace(-L / 2.0, -L / 2.0 + (N - 1) * d_eta, N)
    k = 2.0 * np.pi * np.fft.fftfreq(N, d=d_eta)
    phi = np.exp(-0.5 * eta ** 2) / np.sqrt(2.0 * np.pi)
    He3 = eta ** 3 - 3.0 * eta
    w = phi * He3
    return eta, k, phi, He3, w


def chi_from_fft(cfg, taus, a_pp, g_dimless):
    N = int(cfg.J_n_eta)
    eta, k, phi, He3, w = hermite_objects(N, cfg.J_eta_max)
    w_hat = np.fft.fft(w)
    d3w = np.fft.ifft((1j * k) ** 3 * w_hat).real
    denom = trapz(phi * d3w, eta)
    vals = np.zeros_like(np.asarray(taus, dtype=float))
    for j, tau in enumerate(taus):
        if abs(tau) <= 0.0:
            vals[j] = 0.0
        else:
            phase = np.exp(-1j * g_dimless * tau * k) if abs(g_dimless) > 0.0 else 1.0
            damp = np.exp(-a_pp * tau * k ** 2) * phase
            u_hat = (damp - 1.0) * w_hat
            d3u = np.fft.ifft((1j * k) ** 3 * u_hat).real
            vals[j] = trapz(phi * d3u, eta) / max(denom, 1e-300)
    return vals, denom, eta, phi, He3, w, d3w


def qbr_precompute_chi_base(cfg, tau0, tau_int, a_pp, g_dimless):
    Nt = int(max(cfg.J_n_t, 2))
    taus = np.linspace(0.0, float(tau_int), Nt)
    chi_tau, denom, eta, phi, He3, w, d3w = chi_from_fft(cfg, taus, a_pp, g_dimless)
    C_K = 1.0 / (8.0 * np.sqrt(np.pi))
    denom_ref = 15.0 / 2.0 * C_K
    denom_rel_err = abs(denom - denom_ref) / max(abs(denom_ref), 1e-300)
    Tchi_dimless = trapz((tau_int - taus) * chi_tau, taus)
    Tchi_phys = tau0 ** 2 * Tchi_dimless
    norm_deta3_w = np.sqrt(max(trapz(d3w ** 2, eta), 0.0))
    return {
        "taus": taus,
        "chi_t": chi_tau,
        "tau0": float(tau0),
        "tau_int": float(tau_int),
        "Tchi_dimless": float(Tchi_dimless),
        "Tchi_phys": float(Tchi_phys),
        "norm_deta3_w": float(norm_deta3_w),
        "denom": float(denom),
        "denom_ref": float(denom_ref),
        "denom_rel_err": float(denom_rel_err),
    }


def qbr_eval_band_from_chi_base(cfg, chi_base, omega_min, omega_max, delta_t):
    omega_min = float(omega_min)
    omega_max = float(omega_max)
    base = dict(chi_base)
    if not (np.isfinite(omega_min) and np.isfinite(omega_max) and omega_max > omega_min):
        base.update({
            "J": np.nan,
            "J_realchi": np.nan,
            "J_F": np.nan,
            "chi_avg_weighted": np.nan,
            "flatness": np.nan,
            "flatness_g": np.nan,
            "omega_grid": None,
            "chi_hat_vals_pos": None,
            "chi_hat_vals_neg": None,
            "J_consistency_rel_err": np.nan,
            "Tchi_from_band": np.nan,
            "Tchi_band_rel_err": np.nan,
            "Delta_meas": np.nan,
        })
        return base
    Nt = len(base["taus"])
    taus = base["taus"]
    chi_tau = base["chi_t"]
    tau0 = base["tau0"]
    n_om = int(max(getattr(cfg, "precompute_band_n_omega", 1200), 64))
    ln_om = np.linspace(np.log(omega_min), np.log(omega_max), n_om)
    om = np.exp(ln_om)
    w_tau = np.ones(Nt)
    w_tau[0] = 0.5
    w_tau[-1] = 0.5
    d_tau = taus[1] - taus[0]
    phase_pos = np.exp(1j * np.outer(om * tau0, taus))
    phase_neg = np.exp(-1j * np.outer(om * tau0, taus))
    chi_hat_pos = tau0 * (phase_pos @ (chi_tau * w_tau * d_tau))
    chi_hat_neg = tau0 * (phase_neg @ (chi_tau * w_tau * d_tau))
    F_pos = filter_rectangular_double_sided(om, delta_t)
    omegaF = om * F_pos
    span = max(np.log(omega_max / omega_min), 1e-300)
    log_avg_omegaF = trapz(omegaF, ln_om) / span
    J_F = 1.0 / np.pi * log_avg_omegaF
    num_avg = 2.0 * trapz(omegaF * chi_hat_pos.real, ln_om)
    den_avg = 2.0 * trapz(omegaF, ln_om)
    chi_avg_weighted = num_avg / max(den_avg, 1e-300)
    J_realchi = 1.0 / np.pi * trapz(omegaF * chi_hat_pos.real, ln_om) / span
    ref = J_F * chi_avg_weighted
    J_consistency_rel_err = abs(J_realchi - ref) / max(abs(ref), 1e-300)
    mean_re = max(abs(chi_avg_weighted), 1e-300)
    flatness = float(np.max(np.abs(chi_hat_pos.real / mean_re - 1.0)))
    omegaF_chi_mean = trapz(omegaF * chi_hat_pos.real, ln_om) / span
    g_weight = omegaF * chi_hat_pos.real / max(abs(omegaF_chi_mean), 1e-300)
    flatness_g = float(np.max(np.abs(g_weight - 1.0)))
    Tchi_from_band = J_realchi * span
    Tchi_band_rel_err = relative_error(Tchi_from_band, base["Tchi_phys"])
    base.update({
        "J": float(J_realchi),
        "J_realchi": float(J_realchi),
        "J_F": float(J_F),
        "chi_avg_weighted": float(chi_avg_weighted),
        "flatness": float(flatness),
        "flatness_g": float(flatness_g),
        "omega_grid": om,
        "chi_hat_vals_pos": chi_hat_pos,
        "chi_hat_vals_neg": chi_hat_neg,
        "J_consistency_rel_err": float(J_consistency_rel_err),
        "Tchi_from_band": float(Tchi_from_band),
        "Tchi_band_rel_err": float(Tchi_band_rel_err),
        "Delta_meas": float(np.log(omega_max / omega_min)),
    })
    return base


def qbr_precompute_best_band(cfg, omega_min_default, omega_max_default, chi_base):
    omega_min_default = float(omega_min_default)
    omega_max_default = float(omega_max_default)
    verbose = bool(getattr(cfg, "precompute_band_verbose", True))
    use_precompute = bool(getattr(cfg, "precompute_band", True))
    use_manual = bool(getattr(cfg, "precompute_band_use_manual", False))
    manual_min = float(getattr(cfg, "omega_min", np.nan))
    manual_max = float(getattr(cfg, "omega_max", np.nan))
    manual_valid = bool(np.isfinite(manual_min) and np.isfinite(manual_max) and manual_max > manual_min)

    if not use_precompute:
        if use_manual and manual_valid:
            Jres = qbr_eval_band_from_chi_base(cfg, chi_base, manual_min, manual_max, cfg.delta_t)
            return manual_min, manual_max, Jres["Delta_meas"], Jres, {"mode": "manual"}
        Jres = qbr_eval_band_from_chi_base(cfg, chi_base, omega_min_default, omega_max_default, cfg.delta_t)
        return omega_min_default, omega_max_default, Jres["Delta_meas"], Jres, {"mode": "default"}

    if use_manual and manual_valid:
        Jres = qbr_eval_band_from_chi_base(cfg, chi_base, manual_min, manual_max, cfg.delta_t)
        return manual_min, manual_max, Jres["Delta_meas"], Jres, {"mode": "manual", "score": abs(Jres["chi_avg_weighted"])}

    n_min = int(max(getattr(cfg, "precompute_band_n_min", 36), 2))
    n_max = int(max(getattr(cfg, "precompute_band_n_max", 36), 2))
    low_abs = float(max(getattr(cfg, "precompute_band_low_abs", 0.1), 1e-12))
    low_factor = float(max(getattr(cfg, "precompute_band_low_factor", 300.0), 1.0))
    high_factor = float(max(getattr(cfg, "precompute_band_high_factor", 1.0), 1.0))
    min_delta = float(max(getattr(cfg, "precompute_band_min_delta", 0.05), 1e-12))
    require_finite = bool(getattr(cfg, "precompute_band_require_finite", True))
    require_positive_JF = bool(getattr(cfg, "precompute_band_require_positive_JF", True))

    low_floor = max(low_abs, omega_min_default / low_factor)
    high_ceiling = omega_max_default * high_factor
    if high_ceiling <= low_floor:
        high_ceiling = omega_max_default

    omega_min_grid = np.geomspace(low_floor, omega_min_default, n_min)
    omega_max_grid = np.geomspace(low_floor * np.exp(min_delta), high_ceiling, n_max)
    candidates = []

    def push_candidate(om_min, om_max, source):
        if not (np.isfinite(om_min) and np.isfinite(om_max) and om_max > om_min):
            return
        Delta = np.log(om_max / om_min)
        if not np.isfinite(Delta) or Delta < min_delta:
            return
        try:
            Jres = qbr_eval_band_from_chi_base(cfg, chi_base, om_min, om_max, cfg.delta_t)
        except Exception:
            return
        chi = float(Jres["chi_avg_weighted"])
        JF = float(Jres["J_F"])
        JR = float(Jres["J_realchi"])
        if require_finite and not (np.isfinite(chi) and np.isfinite(JF) and np.isfinite(JR)):
            return
        if require_positive_JF and JF <= 0.0:
            return
        score = abs(JR * Jres["Delta_meas"]) / max(abs(Jres["Tchi_phys"]), 1e-300)
        candidates.append({
            "omega_min": float(om_min),
            "omega_max": float(om_max),
            "Delta_meas": float(Jres["Delta_meas"]),
            "chi_avg_weighted": chi,
            "J_realchi": JR,
            "J_F": JF,
            "flatness": float(Jres["flatness"]),
            "flatness_g": float(Jres["flatness_g"]),
            "Tchi_band_rel_err": float(Jres["Tchi_band_rel_err"]),
            "score": float(score),
            "Jres": Jres,
            "source": source,
        })

    push_candidate(omega_min_default, omega_max_default, "default")
    if manual_valid:
        push_candidate(manual_min, manual_max, "manual_candidate")
    for om_min in omega_min_grid:
        for om_max in omega_max_grid:
            push_candidate(float(om_min), float(om_max), "scan")

    if not candidates:
        Jres = qbr_eval_band_from_chi_base(cfg, chi_base, omega_min_default, omega_max_default, cfg.delta_t)
        return omega_min_default, omega_max_default, Jres["Delta_meas"], Jres, {"mode": "fallback_default"}

    candidates.sort(key=lambda x: (x["Tchi_band_rel_err"], -x["score"]))
    best = candidates[0]

    if verbose:
        print("=" * 120)
        print("[precompute_band] selected by min Tchi_band_rel_err")
        print("default omega_min:", omega_min_default)
        print("default omega_max:", omega_max_default)
        print("selected source:", best["source"])
        print("selected omega_min:", best["omega_min"])
        print("selected omega_max:", best["omega_max"])
        print("selected Delta_meas:", best["Delta_meas"])
        print("selected Tchi_band_rel_err:", best["Tchi_band_rel_err"])
        print("selected chi_avg_weighted:", best["chi_avg_weighted"])
        print("selected J_realchi:", best["J_realchi"])
        print("selected J_F:", best["J_F"])
        print("selected flatness:", best["flatness"])
        print("selected flatness_g:", best["flatness_g"])
        print("=" * 120)

    return best["omega_min"], best["omega_max"], best["Delta_meas"], best["Jres"], {
        "mode": best["source"],
        "score": best["score"],
        "Tchi_band_rel_err": best["Tchi_band_rel_err"],
    }


def compute_remainders(cfg, p_th, epsilon, delta_t, geom, Jres, lambda_eta):
    rho_perp_L2 = geom["rho_perp_L2"] if cfg.rho_perp_L2 == 0.0 else cfg.rho_perp_L2
    V3L2 = geom["V3L2"]
    Tchi_phys = Jres["Tchi_phys"]
    norm_deta3_w = Jres["norm_deta3_w"]
    E_p = p_th * epsilon ** 2 * cfg.C_proj * geom["C_K"] * abs(Tchi_phys) * rho_perp_L2 * V3L2
    E_a = p_th * epsilon ** 2 * cfg.C_adj / 24.0 * ((4.0 / 15.0) * delta_t ** 2.5 + (1.0 / 6.0) * delta_t ** 3.0) * cfg.W0_L2_sup * V3L2
    E_s = p_th * epsilon ** 2 / 24.0 * norm_deta3_w * ((delta_t / max(lambda_eta, 1e-300)) * cfg.W0_proj0_L2 + 0.5 * cfg.C_shape * delta_t ** 2.5 * cfg.N_xi_sup) * V3L2
    E_f = cfg.C_freeze * p_th * epsilon ** 2 * delta_t * abs(Tchi_phys) * (V3L2 + cfg.n0_change_L2_sup)
    return {"E_p": float(E_p), "E_a": float(E_a), "E_s": float(E_s), "E_f": float(E_f), "E_chi": 0.0}


def compute_virtual_environment_response(cfg, p_th, epsilon, K, Jres, rem, delta_p1_direct=np.nan):
    denom_signed = p_th * epsilon ** 2 * K
    denom_abs = p_th * epsilon ** 2 * abs(K)
    Tchi_time = float(Jres["Tchi_phys"])
    Tchi_band = float(Jres["Tchi_from_band"])
    delta_main_time = -denom_signed * Tchi_time
    delta_main_band = -denom_signed * Tchi_band
    rem_total = sum(abs(rem[k]) for k in ["E_p", "E_a", "E_s", "E_f", "E_chi"])
    Tvirt_p_bound = abs(rem["E_p"]) / max(denom_abs, 1e-300)
    Tvirt_a_bound = abs(rem["E_a"]) / max(denom_abs, 1e-300)
    Tvirt_s_bound = abs(rem["E_s"]) / max(denom_abs, 1e-300)
    Tvirt_f_bound = abs(rem["E_f"]) / max(denom_abs, 1e-300)
    Tvirt_chi_bound = abs(rem["E_chi"]) / max(denom_abs, 1e-300)
    Tvirt_total_bound = rem_total / max(denom_abs, 1e-300)
    T_eff_direct = np.nan
    Tvirt_direct_vs_time = np.nan
    Tvirt_direct_vs_band = np.nan
    if np.isfinite(delta_p1_direct) and abs(denom_signed) > 1e-300:
        T_eff_direct = -delta_p1_direct / denom_signed
        Tvirt_direct_vs_time = T_eff_direct - Tchi_time
        Tvirt_direct_vs_band = T_eff_direct - Tchi_band
    return {
        "Tchi_time": float(Tchi_time),
        "Tchi_band": float(Tchi_band),
        "delta_p1_main_time": float(delta_main_time),
        "delta_p1_main_band": float(delta_main_band),
        "Tvirt_p_bound": float(Tvirt_p_bound),
        "Tvirt_a_bound": float(Tvirt_a_bound),
        "Tvirt_s_bound": float(Tvirt_s_bound),
        "Tvirt_f_bound": float(Tvirt_f_bound),
        "Tvirt_chi_bound": float(Tvirt_chi_bound),
        "Tvirt_total_bound": float(Tvirt_total_bound),
        "Tvirt_bound_over_Tchi_time": float(Tvirt_total_bound / max(abs(Tchi_time), 1e-300)),
        "Tvirt_bound_over_Tchi_band": float(Tvirt_total_bound / max(abs(Tchi_band), 1e-300)),
        "T_eff_direct": float(T_eff_direct),
        "Tvirt_direct_vs_time": float(Tvirt_direct_vs_time),
        "Tvirt_direct_vs_band": float(Tvirt_direct_vs_band),
        "Tvirt_direct_over_Tchi_time": float(abs(Tvirt_direct_vs_time) / max(abs(Tchi_time), 1e-300)) if np.isfinite(Tvirt_direct_vs_time) else np.nan,
        "Tvirt_direct_over_Tchi_band": float(abs(Tvirt_direct_vs_band) / max(abs(Tchi_band), 1e-300)) if np.isfinite(Tvirt_direct_vs_band) else np.nan,
    }


